# Supabase credentials — same URL/key in both pairs.
# The NEXT_PUBLIC_ pair is required (used by the browser, middleware, and
# the extension via /api/config). The anon key is a public, publishable
# value; your data is protected by Row Level Security, not by this key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-side fallbacks (optional if the NEXT_PUBLIC_ pair is set)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
