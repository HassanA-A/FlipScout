{
  "manifest_version": 3,
  "name": "FlipScout — Analyze with FlipScout",
  "version": "0.2.0",
  "description": "Capture the listing you're viewing and send it to your FlipScout board for deal analysis.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Analyze with FlipScout"
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "browser_specific_settings": {
    "gecko": {
      "id": "flipscout@flipscout.app",
      "strict_min_version": "115.0"
    }
  }
}
